generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  USER
}

enum TipoReferencia {
  INTERNA
  EXTERNA
}

enum EstadoIncidencia {
  PENDIENTE
  RESUELTA
}

enum EstadoReunion {
  PENDIENTE
  CONFIRMADA
  REALIZADA
  CANCELADA
}

model Usuario {
  id              String @id @default(uuid())
  nombre          String
  apellido        String
  empresa         String?
  username        String @unique
  email           String @unique
  telefono        String?
  fechaNacimiento DateTime?
  passwordHash    String
  activo          Boolean @default(true)
  rol             Rol @default(USER)

  isVerified                Boolean @default(false)
  emailVerificationToken    String?
  emailVerificationExpires  DateTime?

  createdAt       DateTime @default(now())

  referenciasEnviadas   Referencia[] @relation("ReferenciaEmisor")
  referenciasRecibidas  Referencia[] @relation("ReferenciaReceptor")

  agradecimientosEnviados  Agradecimiento[] @relation("AgradecimientoEmisor")
  agradecimientosRecibidos Agradecimiento[] @relation("AgradecimientoReceptor")

  reunionesEnviadas    Reunion[] @relation("ReunionCreador")
  reunionesRecibidas   Reunion[] @relation("ReunionInvitado")

  incidencias Incidencia[]
}

model Referencia {
  id          String @id @default(uuid())
  emisorId    String
  receptorId  String

  nombreContacto    String
  telefonoContacto  String?
  emailContacto     String?
  cargoContacto     String?
  fechaReferencia   DateTime?
  descripcion       String?
  tipo              TipoReferencia @default(INTERNA)

  createdAt         DateTime @default(now())
  viewedAt          DateTime?

  emisor   Usuario @relation("ReferenciaEmisor", fields: [emisorId], references: [id])
  receptor Usuario @relation("ReferenciaReceptor", fields: [receptorId], references: [id])

  agradecimientos Agradecimiento[]

  @@index([emisorId])
  @@index([receptorId])
}

model Agradecimiento {
  id              String   @id @default(uuid())
  emisorId        String
  receptorId      String
  nombreContacto  String
  referenciaId    String?

  importe       Float
  fechaNegocio  DateTime @default(now())
  createdAt     DateTime @default(now())

  emisor   Usuario @relation("AgradecimientoEmisor", fields: [emisorId], references: [id])
  receptor Usuario @relation("AgradecimientoReceptor", fields: [receptorId], references: [id])

  referencia Referencia? @relation(fields: [referenciaId], references: [id])  
}

model Reunion {
  id            String   @id @default(uuid())

  creadorId     String
  invitadoId    String

  fecha         DateTime
  descripcion   String?

  estado        EstadoReunion @default(PENDIENTE)

  createdAt     DateTime @default(now())
  viewedAt      DateTime?

  creador       Usuario @relation("ReunionCreador", fields: [creadorId], references: [id])
  invitado      Usuario @relation("ReunionInvitado", fields: [invitadoId], references: [id])

  @@index([creadorId])
  @@index([invitadoId])
}

model Incidencia {
  id          String   @id @default(uuid())
  usuarioId   String

  asunto      String
  descripcion String
  estado      EstadoIncidencia @default(PENDIENTE)

  fechaIncidencia   DateTime @default(now())
  createdAt   DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}


